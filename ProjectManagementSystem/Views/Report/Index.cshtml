@model ProjectManagementSystem.Models.ReportViewModel

@{
    ViewData["Title"] = "التقارير";
    var projectOptions = ViewBag.Projects as SelectList;
    var percentage = Math.Clamp(Model.CompletionPercentage, 0, 100);
    var statusText = percentage >= 75 ? "أداء ممتاز" : percentage >= 40 ? "تقدم جيد" : "يحتاج متابعة";
    var statusClass = percentage >= 75
        ? "badge-status badge-status--done"
        : percentage >= 40
            ? "badge-priority badge-priority--medium"
            : "badge-priority badge-priority--high";
}

<section class="page-hero">
    <div>
        <span class="page-hero__eyebrow">متابعة الإنجاز</span>
        <h1>@(string.IsNullOrWhiteSpace(Model.ProjectName) ? "تقرير المهام" : $"تقرير: {Model.ProjectName}")</h1>
        <p>نظرة عامة على حالة المهام ونسبة الإنجاز، مع إمكانية التصفية حسب المشروع.</p>
    </div>
    <span class="@statusClass">@statusText</span>
</section>

<form method="get" asp-action="Index" class="filter-bar">
    <div class="form-field filter-bar__field">
        <label for="projectId">تصفية حسب المشروع</label>
        <select id="projectId" name="projectId" class="form-control" onchange="this.form.submit()">
            <option value="">كل المشاريع</option>
            @if (projectOptions != null)
            {
                foreach (var option in projectOptions)
                {
                    if (option.Selected)
                    {
                        <option value="@option.Value" selected>@option.Text</option>
                    }
                    else
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                }
            }
        </select>
    </div>
</form>

<div class="stat-grid">
    <article class="stat-card">
        <span>إجمالي المهام</span>
        <strong>@Model.TotalTasks</strong>
    </article>
    <article class="stat-card">
        <span>جديدة</span>
        <strong>@Model.NewTasks</strong>
    </article>
    <article class="stat-card">
        <span>قيد التنفيذ</span>
        <strong>@Model.InProgressTasks</strong>
    </article>
    <article class="stat-card">
        <span>المهام المنجزة</span>
        <strong>@Model.CompletedTasks</strong>
    </article>
</div>

<div class="panel detail-panel report-panel">
    <span class="page-hero__eyebrow">تقدم العمل</span>
    <h2 class="section-title">@percentage.ToString("0")%</h2>
    <p>تم إنجاز <strong>@Model.CompletedTasks</strong> من أصل <strong>@Model.TotalTasks</strong> مهام، والمتبقي <strong>@Model.RemainingTasks</strong>.</p>

    <div class="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percentage.ToString("0")">
        <div class="progress-fill" style="width:@percentage.ToString("0.##")%"></div>
    </div>

    <div class="report-legend">
        <span><i class="legend-dot legend-dot--done"></i> منجز @Model.CompletedTasks</span>
        <span><i class="legend-dot legend-dot--remain"></i> متبقي @Model.RemainingTasks</span>
    </div>
</div>
