@model ProjectManagementSystem.Models.ReportViewModel

@{
    ViewData["Title"] = "تقرير المشروع";

    var percentage = Math.Clamp(Model.CompletionPercentage, 0, 100);

    string statusText;
    string statusClass;

    if (percentage >= 75)
    {
        statusText = "أداء ممتاز";
        statusClass = "status-success";
    }
    else if (percentage >= 40)
    {
        statusText = "تقدم جيد";
        statusClass = "status-warning";
    }
    else
    {
        statusText = "يحتاج متابعة";
        statusClass = "status-danger";
    }
}

<div class="report-page" dir="rtl">

    <div class="report-shell">

        <section class="report-header">
            <div>
                <span class="eyebrow">لوحة المتابعة</span>

                <h1>تقرير المشروع</h1>

                <p>
                    نظرة عامة على حالة المهام ومستوى التقدم الحالي في المشروع
                </p>
            </div>

            <div class="header-meta">
                <span class="status-pill @statusClass">
                    <span class="status-dot"></span>
                    @statusText
                </span>
            </div>
        </section>


        <section class="stats-grid">

            <article class="stat-card">
                <div class="stat-icon icon-blue">📋</div>

                <div class="stat-content">
                    <span class="stat-label">إجمالي المهام</span>

                    <strong class="stat-value">
                        @Model.TotalTasks
                    </strong>

                    <span class="stat-caption">
                        جميع المهام المسجلة
                    </span>
                </div>
            </article>


            <article class="stat-card">
                <div class="stat-icon icon-green">✓</div>

                <div class="stat-content">
                    <span class="stat-label">المهام المنجزة</span>

                    <strong class="stat-value">
                        @Model.CompletedTasks
                    </strong>

                    <span class="stat-caption">
                        تم إكمالها بنجاح
                    </span>
                </div>
            </article>


            <article class="stat-card">
                <div class="stat-icon icon-purple">%</div>

                <div class="stat-content">
                    <span class="stat-label">نسبة الإنجاز</span>

                    <strong class="stat-value">
                        @percentage.ToString("0.0")%
                    </strong>

                    <span class="stat-caption">
                        مستوى التقدم الحالي
                    </span>
                </div>
            </article>

        </section>


        <section class="progress-card">

            <div class="progress-top">

                <div>
                    <span class="section-kicker">
                        تقدم المشروع
                    </span>

                    <h2>
                        @percentage.ToString("0")%
                    </h2>

                    <p>
                        تم إنجاز
                        <strong>@Model.CompletedTasks</strong>
                        من أصل
                        <strong>@Model.TotalTasks</strong>
                        مهام
                    </p>
                </div>

                <div class="progress-ring"
                     style="--progress:@percentage">

                    <div class="progress-ring-inner">
                        <strong>@percentage.ToString("0")%</strong>
                        <span>مكتمل</span>
                    </div>
                </div>

            </div>


            <div class="progress-track">
                <div class="progress-fill"
                     style="width:@percentage%">
                </div>
            </div>


            <div class="progress-footer">

                <div>
                    <span class="progress-dot dot-completed"></span>
                    منجز
                    <strong>@Model.CompletedTasks</strong>
                </div>

                <div>
                    <span class="progress-dot dot-remaining"></span>
                    متبقي
                    <strong>@Model.RemainingTasks</strong>
                </div>

            </div>

        </section>


        <section class="summary-card">

            <div class="summary-header">
                <span class="section-kicker">الملخص</span>

                <h3>حالة المشروع الحالية</h3>
            </div>


            <div class="summary-grid">

                <div class="summary-item">
                    <span>إجمالي المهام</span>
                    <strong>@Model.TotalTasks</strong>
                </div>

                <div class="summary-divider"></div>

                <div class="summary-item">
                    <span>المهام المنجزة</span>
                    <strong class="success-number">
                        @Model.CompletedTasks
                    </strong>
                </div>

                <div class="summary-divider"></div>

                <div class="summary-item">
                    <span>المهام المتبقية</span>
                    <strong class="danger-number">
                        @Model.RemainingTasks
                    </strong>
                </div>

            </div>

        </section>

    </div>

</div>


<style>

    :root {
        --bg: #f5f7fb;
        --surface: #ffffff;
        --text: #172033;
        --muted: #7b8497;
        --border: #e8ebf2;
        --primary: #5b6cf9;
        --primary-soft: #eef0ff;
        --success: #20b486;
        --success-soft: #eafaf4;
        --warning: #f3a11a;
        --warning-soft: #fff5df;
        --danger: #e85c70;
        --danger-soft: #fff0f3;
        --purple: #8667f2;
        --purple-soft: #f1edff;
        --shadow: 0 12px 32px rgba(24, 39, 75, 0.06);
    }

    body {
        background: var(--bg);
        color: var(--text);
        font-family: "Segoe UI", Tahoma, Arial, sans-serif;
    }

    .report-page {
        min-height: 100vh;
        padding: 42px 20px 60px;
    }

    .report-shell {
        width: min(1180px, 100%);
        margin: 0 auto;
    }

    .report-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 30px;
        margin-bottom: 30px;
    }

    .eyebrow,
    .section-kicker {
        display: block;
        margin-bottom: 8px;
        color: var(--primary);
        font-size: 13px;
        font-weight: 700;
    }

    .report-header h1 {
        margin: 0 0 10px;
        font-size: 40px;
        font-weight: 800;
    }

    .report-header p {
        margin: 0;
        color: var(--muted);
        line-height: 1.8;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: currentColor;
    }

    .status-success {
        color: #168566;
        background: var(--success-soft);
    }

    .status-warning {
        color: #b3740b;
        background: var(--warning-soft);
    }

    .status-danger {
        color: #b54155;
        background: var(--danger-soft);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 20px;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 18px;
        min-height: 150px;
        padding: 24px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        box-shadow: var(--shadow);
    }

    .stat-icon {
        width: 58px;
        height: 58px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        font-size: 22px;
        font-weight: 800;
    }

    .icon-blue {
        color: var(--primary);
        background: var(--primary-soft);
    }

    .icon-green {
        color: var(--success);
        background: var(--success-soft);
    }

    .icon-purple {
        color: var(--purple);
        background: var(--purple-soft);
    }

    .stat-content {
        display: flex;
        flex-direction: column;
    }

    .stat-label {
        color: var(--muted);
        font-size: 14px;
        font-weight: 600;
    }

    .stat-value {
        font-size: 34px;
        font-weight: 800;
    }

    .stat-caption {
        color: #a1a8b6;
        font-size: 12px;
    }

    .progress-card,
    .summary-card {
        padding: 30px;
        margin-bottom: 20px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 24px;
        box-shadow: var(--shadow);
    }

    .progress-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 30px;
        margin-bottom: 24px;
    }

    .progress-top h2 {
        margin: 0 0 5px;
        font-size: 42px;
        font-weight: 800;
    }

    .progress-top p {
        margin: 0;
        color: var(--muted);
    }

    .progress-ring {
        --size: 116px;
        width: var(--size);
        height: var(--size);
        display: grid;
        place-items: center;
        border-radius: 50%;
        background:
            conic-gradient(
                var(--primary) calc(var(--progress) * 1%),
                #eef1f6 0
            );
        position: relative;
    }

    .progress-ring::before {
        content: "";
        position: absolute;
        width: 88px;
        height: 88px;
        border-radius: 50%;
        background: white;
    }

    .progress-ring-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .progress-ring-inner strong {
        font-size: 24px;
        font-weight: 800;
    }

    .progress-ring-inner span {
        color: var(--muted);
        font-size: 11px;
    }

    .progress-track {
        height: 12px;
        background: #edf0f5;
        border-radius: 999px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #6f7bf7, #5868f3);
    }

    .progress-footer {
        display: flex;
        gap: 26px;
        margin-top: 16px;
        color: var(--muted);
        font-size: 13px;
    }

    .progress-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        margin-left: 5px;
    }

    .dot-completed {
        background: var(--primary);
    }

    .dot-remaining {
        background: #d8dde7;
    }

    .summary-header h3 {
        margin: 0;
        font-size: 20px;
        font-weight: 800;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: 1fr auto 1fr auto 1fr;
        align-items: center;
        gap: 28px;
        margin-top: 24px;
    }

    .summary-item {
        text-align: center;
    }

    .summary-item span {
        display: block;
        margin-bottom: 8px;
        color: var(--muted);
        font-size: 13px;
    }

    .summary-item strong {
        font-size: 30px;
        font-weight: 800;
    }

    .summary-divider {
        width: 1px;
        height: 52px;
        background: var(--border);
    }

    .success-number {
        color: var(--success);
    }

    .danger-number {
        color: var(--danger);
    }

    @@media (max-width: 900px) {

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .report-header {
            flex-direction: column;
        }
    }

    @@media (max-width: 640px) {

        .progress-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .progress-ring {
            align-self: center;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .summary-divider {
            width: 100%;
            height: 1px;
        }
    }

</style>