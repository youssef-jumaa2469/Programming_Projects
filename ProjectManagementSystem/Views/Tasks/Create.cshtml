@model ProjectManagementSystem.Models.Task

@{
    ViewData["Title"] = "إضافة مهمة";
}

<section class="page-hero">
    <div>
        <span class="page-hero__eyebrow">مهمة جديدة</span>
        <h1>إضافة مهمة</h1>
        <p>أدخل بيانات المهمة واربطها بالمشروع المناسب ثم احفظ للمتابعة.</p>
    </div>
    <partial name="_ModuleSwitch" />
</section>

<div class="panel panel--form">
    <form asp-action="Create" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="ParentTaskId" />

        <div class="form-field">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" placeholder="مثال: إعداد هيكل قاعدة البيانات" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="وصف مختصر يوضح المطلوب إنجازه"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="ProjectId"></label>
            <select asp-for="ProjectId" class="form-control" asp-items="ViewBag.ProjectId">
                <option value="0">اختر المشروع</option>
            </select>
            <span asp-validation-for="ProjectId" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Priority"></label>
            <select asp-for="Priority" class="form-control">
                <option value="منخفضة">منخفضة</option>
                <option value="متوسطة">متوسطة</option>
                <option value="عالية">عالية</option>
            </select>
            <span asp-validation-for="Priority" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Status"></label>
            <select asp-for="Status" class="form-control">
                <option value="جديدة">جديدة</option>
                <option value="قيد التنفيذ">قيد التنفيذ</option>
                <option value="منجزة">منجزة</option>
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-app btn-app--primary">حفظ</button>
            <a class="btn-app btn-app--ghost" asp-action="Index">إلغاء</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
