@model ProjectManagementSystem.Models.Task

@{
    ViewData["Title"] = "حذف مهمة";
}

<section class="page-hero">
    <div>
        <span class="page-hero__eyebrow">تأكيد الحذف</span>
        <h1>حذف المهمة</h1>
        <p>هذا الإجراء لا يمكن التراجع عنه.</p>
    </div>
    <partial name="_ModuleSwitch" />
</section>

<div class="panel detail-panel">
    <div class="alert-soft">هل أنت متأكد أنك تريد حذف هذه المهمة؟</div>

    <dl class="detail-list">
        <div>
            <dt>@Html.DisplayNameFor(model => model.Title)</dt>
            <dd>@Model.Title</dd>
        </div>
        <div>
            <dt>@Html.DisplayNameFor(model => model.Description)</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>
        </div>
        <div>
            <dt>@Html.DisplayNameFor(model => model.Project)</dt>
            <dd>@(Model.Project?.Name ?? "—")</dd>
        </div>
        <div>
            <dt>@Html.DisplayNameFor(model => model.Priority)</dt>
            <dd>@WorkItemLabels.Priority(Model.Priority)</dd>
        </div>
        <div>
            <dt>@Html.DisplayNameFor(model => model.Status)</dt>
            <dd>@WorkItemLabels.Status(Model.Status)</dd>
        </div>
    </dl>

    <form asp-action="Delete" class="form-actions" style="margin-top: 1.5rem;">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn-app btn-app--danger">تأكيد الحذف</button>
        <a class="btn-app btn-app--ghost" asp-action="Index">إلغاء</a>
    </form>
</div>
